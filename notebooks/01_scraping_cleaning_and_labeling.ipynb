      "source": [
        "header = ['Predicted Label', 'Score of Predicted Label']\n",
        "with open('tweet_label_score.csv', 'w') as f:\n",
        "    writer = csv.writer(f)\n",
        "    writer.writerow(header)\n",
        "\n",
        "    for i in clean_text_list:\n",
        "      result = happy_tc.classify_text(i)\n",
        "      writer.writerows(zip([result.label], [result.score]))\n",
        "      f.close"
      ],
