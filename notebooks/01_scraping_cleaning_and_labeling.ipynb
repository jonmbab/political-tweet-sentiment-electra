      "source": [
        "# assigning parties to to their respective politicians from their twitter profile bio\n",
        "party = []\n",
        "for i in df_profiles.index:\n",
        "    bio = df_profiles.Bio[i].lower()\n",
        "    if bool(re.search(\"cdu|csu|christlich|union\", bio)):\n",
        "        party.append(\"CDU/CSU\")\n",
        "    elif bool(re.search(\"spd|sozialdemo|juso\", bio)):\n",
        "        party.append(\"SPD\")\n",
        "    elif bool(re.search(\"grün|bündnis 90|gruen\", bio)):\n",
        "        party.append(\"Grüne\")\n",
        "    elif bool(re.search(\"fdp|liberal|juli\", bio)):\n",
        "        party.append(\"FDP\")\n",
        "    elif bool(re.search(\"linke|linksfr\", bio)):\n",
        "        party.append(\"Linke\")\n",
        "    elif bool(re.search(\"afd|alternative für\", bio)):\n",
        "        party.append(\"AfD\")\n",
        "    else:\n",
        "        party.append(\"N/A\")\n",
        "        \n",
        "df_profiles[\"Party\"] = party"
      ],
      "id": "334143cf"
    },
