        "tweets_df['Party'] = tweets_df['Username']"
      ],
      "id": "46VT6TO9OvD0"
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "_5HTPOKuAimz"
      },
      "outputs": [],
      "source": [
        "# dropping every colunm except usernames and drop duplicate usernames\n",
        "# so that a username only appears once\n",
        "name_party = pd.read_csv('name_party.csv')\n",
        "name_party.drop_duplicates(subset=\"Username\", keep='first', inplace=True)\n",
        "name_party.drop(columns=['Text', 'Tweet Id', 'Datetime', 'Url'], inplace=True)"
      ],
      "id": "_5HTPOKuAimz"
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "ZyvsGYb7I49i"
      },
      "outputs": [],
      "source": [
        "# duplicate name_party['Username'] column and create two new columns ['Name'] and ['Party']\n",
        "name_party['Name'] = name_party['Username']\n",
        "name_party['Party'] = name_party['Username']\n",
        "\n",
        "# # create a dictionary of usernames and names as well as usernames and party\n",
        "name = dict(zip(name_party['Name'], df_profiles['Name']))\n",
        "party = dict(zip(name_party['Party'], df_profiles['Party']))\n",
        "\n",
        "# apply dictionaries to the original tweets_df \n",
        "for old, new in name.items():\n",
        "      tweets_df['Name'] = tweets_df['Name'].str.replace(old, new, regex=True)\n",
        "\n",
        "for old, new in party.items():\n",
        "      tweets_df['Party'] = tweets_df['Party'].str.replace(old, new, regex=True)"
      ],
      "id": "ZyvsGYb7I49i"
    },
