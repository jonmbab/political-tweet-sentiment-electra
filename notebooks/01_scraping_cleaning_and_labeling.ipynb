      "source": [
        "# scraping of tweets from politicians via snscraper\n",
        "# using the twitter account from \"MdB (Bundestag), @wahl_beobachter\"\n",
        "# which serves as an aggregator and provides a list containing all the accounts of members of the German Bundestag\n",
        "maxTweets = 30000\n",
        "tweets_list = []\n",
        "for i,tweet in enumerate(sntwitter.TwitterSearchScraper('list:912241909002833921').get_items()):\n",
        "    if i>maxTweets:\n",
        "        break\n",
        "    tweets_list.append([tweet.date, tweet.id, tweet.rawContent, tweet.user.username, tweet.url])\n",
        "tweets_df = pd.DataFrame(tweets_list, columns=['Datetime', 'Tweet Id', 'Text', 'Username', \"Url\"])"
      ],
      "id": "f4918f3b"
    },
