        "# scraping of politicians twitter profiles via selenium and chrome browser to aquire names and party affiliation of politicians \n",
        "names = []\n",
        "handles = []\n",
        "bios = []\n",
        "photos = []\n",
        "for i, username in enumerate(usernames):\n",
        "    driver.get(f\"https://twitter.com/{username}\")\n",
        "    sys.stdout.write(f\"\\rIteration scraping {i+1}/{len(usernames)}\")\n",
        "    try:\n",
        "        WebDriverWait(driver, 10).until(EC.title_contains(\"@\"))\n",
        "       \n",
        "        name = driver.find_element(By.XPATH, \"/html/body/div[1]/div/div/div[2]/main/div/div/div/div/div/div[3]/div/div/div/div/div[2]/div[1]/div/div[1]/div/div/span[1]/span\").text\n",
        "        handle = driver.find_element(By.XPATH, \"/html/body/div[1]/div/div/div[2]/main/div/div/div/div/div/div[3]/div/div/div/div/div[2]/div[1]/div/div[2]/div/div/div/span\").text\n",
        "        try:\n",
        "            bio = driver.find_element(By.CSS_SELECTOR, \"div[data-testid='UserDescription']\").text\n",
        "        except:\n",
        "            bio = \"\"\n",
        "        photo = f\"https://twitter.com/{username}/photo\"\n",
        "        names.append(name)\n",
        "        handles.append(handle)\n",
        "        bios.append(bio)\n",
        "        photos.append(photo)\n",
        "    except:\n",
        "        print(f\"No data for username: {username}\")\n",
        "df_profiles = pd.DataFrame.from_dict({'Name': names, 'Handle': handles, 'Photo': photos, 'Bio': bios}) \n",
        "driver.close()"
      ],
      "id": "b90ca922"
    },
