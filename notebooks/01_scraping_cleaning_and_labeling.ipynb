      "source": [
        "clean_tweets_df = pd.read_csv('clean_tweets_df.csv')\n",
        "\n",
        "# # duplicate every tweet 6 times in clean_tweets_df_6\n",
        "clean_tweets_df_6 = pd.DataFrame(np.repeat(clean_tweets_df.values, 6, axis=0), columns=clean_tweets_df.columns)\n",
        "\n",
        "# add party label to every tweet --> every tweet can now be considered as a statement of each of the parties\n",
        "clean_tweets_df_6.loc[::6,\"Clean Text\"] ='cdu/csu: ' + clean_tweets_df_6['Clean Text'].astype(str)\n",
        "clean_tweets_df_6.loc[1::6,\"Clean Text\"] ='spd: ' + clean_tweets_df_6['Clean Text'].astype(str)\n",
        "clean_tweets_df_6.loc[2::6,\"Clean Text\"] ='grüne: ' + clean_tweets_df_6['Clean Text'].astype(str)\n",
        "clean_tweets_df_6.loc[3::6,\"Clean Text\"] ='die linke: ' + clean_tweets_df_6['Clean Text'].astype(str)\n",
        "clean_tweets_df_6.loc[4::6,\"Clean Text\"] ='fdp: ' + clean_tweets_df_6['Clean Text'].astype(str)\n",
        "clean_tweets_df_6.loc[5::6,\"Clean Text\"] ='afd: ' + clean_tweets_df_6['Clean Text'].astype(str)"
      ],
      "id": "92uunXTMeclq"
