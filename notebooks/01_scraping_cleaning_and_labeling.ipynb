      "source": [
        "# webdriver setup so that chrome is able to scrape politicians twitter profiles\n",
        "def SetupDriver():\n",
        "    options = ChromeOptions()\n",
        "    ua = Headers().generate()\n",
        "    options.add_argument(f'user-agent={ua}') # optional\n",
        "    options.add_argument('--headless') # needed otherwise chrome will crash in colab!!!  \n",
        "    options.add_argument('--no-sandbox') # needed otherwise chrome will crash in colab!!!  \n",
        "    options.add_argument(\"--disable-dev-shm-usage\") # optional\n",
        "    options.add_argument('--ignore-certificate-errors') # optional\n",
        "    options.add_argument('--disable-gpu') # optional\n",
        "    options.add_argument('--log-level=3') # optional\n",
        "    options.add_argument('--disable-notifications') # optional\n",
        "    options.add_argument('--disable-popup-blocking') # optional\n",
        "    driver = webdriver.Chrome('chromedriver', options=options)\n",
        "    wait = WebDriverWait(driver, 5)\n",
        "    return driver"
      ],
      "id": "jH8ii5uIBII5"
    },
