      "outputs": [],
      "source": [
        "tweet_label_score = pd.read_csv('tweet_label_score.csv')\n",
        "\n",
        "# changing labels to type int and adding a sentiment column\n",
        "tweet_label_score.loc[tweet_label_score['Predicted Label'].str.contains('LABEL_0'), 'Predicted Label'] = 0\n",
        "tweet_label_score.loc[tweet_label_score['Predicted Label'].str.contains('LABEL_1', na=False), 'Predicted Label'] = 1\n",
        "tweet_label_score['Predicted Label'] = tweet_label_score['Predicted Label'].astype(int)\n",
        "tweet_label_score['Sentiment of Predicted Label'] = np.where(tweet_label_score['Predicted Label'] == 1, 'negative', 'positive')\n",
        "\n",
        "# combining party labeled tweets and label\n",
        "clean_tweets_df_6 = pd.concat([clean_tweets_df_6, tweet_label_score], axis=1)\n",
        "\n",
        "# layout of final dataframe\n",
        "clean_tweets_df_6 = clean_tweets_df_6[['Username', 'Name', 'Clean Name', 'Party','Text', 'Clean Text', 'Predicted Label', 'Score of Predicted Label', 'Sentiment of Predicted Label','Tweet Word Count', 'Tweet Id', 'Datetime', 'Url', 'Language']]"
      ],
