      "source": [
        "# creating a duplicate of the Tweets_df['Name'] column which will be cleaned so that the names of the \n",
        "# politicians will be shown properly\n",
        "tweets_df['Clean Name'] = tweets_df['Name']"
      ],
      "id": "12bDqPACdi3l"
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "L9eZJ73rWVs_"
      },
      "outputs": [],
      "source": [
        "# manual clean up of the tweets_df['Clean Name'] column regarding suffixes used by more than one politician\n",
        "tweets_df['Clean Name'] = tweets_df['Clean Name'].str.replace(\", MdB\",\"\", regex=True)\n",
        "tweets_df['Clean Name'] = tweets_df['Clean Name'].str.replace(\"MdB\",\"\", regex=True)\n",
        "tweets_df['Clean Name'] = tweets_df['Clean Name'].str.replace(\"|\", \"\", regex=True)\n",
        "tweets_df['Clean Name'] = tweets_df['Clean Name'].str.replace(\" - MdB\",\"\", regex=True)\n",
        "tweets_df['Clean Name'] = tweets_df['Clean Name'].str.replace(\" (MdB)\",\"\", regex=True)\n",
        "tweets_df['Clean Name'] = tweets_df['Clean Name'].str.replace(\" (MdB, AfD)\",\"\", regex=True)\n",
        "tweets_df['Clean Name'] = tweets_df['Clean Name'].str.replace(\", MdB, AfD\",\"\", regex=True)\n",
        "tweets_df['Clean Name'] = tweets_df['Clean Name'].str.replace(\" MdB (FDP)\",\"\", regex=True)\n",
        "tweets_df['Clean Name'] = tweets_df['Clean Name'].str.replace(\" (MdB, AfD)\",\"\", regex=True)\n",
        "tweets_df['Clean Name'] = tweets_df['Clean Name'].str.replace(\" MdB, Parl.Geschäftsführer\",\"\", regex=True)\n",
        "tweets_df['Clean Name'] = tweets_df['Clean Name'].str.replace(\" AfD MdB\",\"\", regex=True)\n",
        "tweets_df['Clean Name'] = tweets_df['Clean Name'].str.replace(\", AfD MdB\",\"\", regex=True)\n",
        "tweets_df['Clean Name'] = tweets_df['Clean Name'].str.replace(\", AfD\",\"\", regex=True)\n",
        "tweets_df['Clean Name'] = tweets_df['Clean Name'].str.replace(\"AfD\",\"\", regex=True)\n",
        "tweets_df['Clean Name'] = tweets_df['Clean Name'].str.replace(\" #FreeAlexanderKabanov\",\"\", regex=True)\n",
        "\n",
        "# manual clean up of the tweets_df['Clean Name'] column regarding names used by one specific politician\n",
        "tweets_df['Clean Name'] = tweets_df['Clean Name'].str.replace(\"Anke DomscheitBerg @ankedb@social.linksfraktion.de\", \"Anke Domscheit-Berg\", regex=True)\n",
        "tweets_df['Clean Name'] = tweets_df['Clean Name'].str.replace(\"Awet\", \"Awet Tesfaiesus\", regex=True)\n",
        "tweets_df['Clean Name'] = tweets_df['Clean Name'].str.replace(\"BengtBergt\", \"Bengt Bergt\", regex=True) \n",
        "tweets_df['Clean Name'] = tweets_df['Clean Name'].str.replace(\"SteffiLemke\", \"Steffi Lemke\", regex=True)\n",
        "tweets_df['Clean Name'] = tweets_df['Clean Name'].str.replace(\"Bernd Riexinger ☮︎\", \"Bernd Riexinger\", regex=True)\n",
        "tweets_df['Clean Name'] = tweets_df['Clean Name'].str.replace(\"Dr. forest Christoph Hoffmann\", \"Dr. Forest Christoph Hoffmann\", regex=True)\n",
        "tweets_df['Clean Name'] = tweets_df['Clean Name'].str.replace(\"Dr. Wolfgang Strengmann-Kuhn gruene.social/@w_sk\", \"Dr. Wolfgang Strengmann-Kuhn\", regex=True)\n",
        "tweets_df['Clean Name'] = tweets_df['Clean Name'].str.replace(\"Frank Schwabe #LetAfghanGirlsLearn\", \"Frank Schwabe\", regex=True)\n",
        "tweets_df['Clean Name'] = tweets_df['Clean Name'].str.replace(\"KristianKlinck\", \"Kristian Klinck\", regex=True)\n",
        "tweets_df['Clean Name'] = tweets_df['Clean Name'].str.replace(\"Maria Klein-Schmeink *Impfen schützt - Maske auch*\", \"Maria Klein-Schmeink\", regex=True)\n",
        "tweets_df['Clean Name'] = tweets_df['Clean Name'].str.replace(\"OttO Fricke\", \"Otto Fricke\", regex=True)\n",
        "tweets_df['Clean Name'] = tweets_df['Clean Name'].str.replace(\"ᴘᴇᴛʀ ʙʏsᴛʀᴏɴ\", \"Petr Bystron\", regex=True)\n",
        "\n",
        "# removing special characters from the tweets_df['Name'] column\n",
        "spec_chars = [\"!\",'\"','\"\"',\"#\",\"%\",\"&\",\"'\",\"(\",\")\",\n",
        "              \"*\",\"+\",\",\",\"/\",\":\",\";\",\"<\",\n",
        "              \"=\",\">\",\"?\",\"[\",\"\\\\\",\"]\",\"^\",\"_\",\n",
        "              \"`\",\"{\",\"|\",\"}\",\"~\",]\n",
        "\n",
        "for char in spec_chars:\n",
        "    tweets_df[\"Clean Name\"] = tweets_df[\"Clean Name\"].str.replace(char, '', regex=True)"
      ],
      "id": "L9eZJ73rWVs_"
    },
