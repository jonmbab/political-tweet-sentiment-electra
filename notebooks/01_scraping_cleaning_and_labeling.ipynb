      "source": [
        "# @ mentions and URL removal section\n",
        "# removal of @ mentions within clean text \n",
        "tweets_df[\"Clean Text\"] = tweets_df[\"Clean Text\"].str.replace(\"@[A-Za-z0-9_]+\",\"\", regex=True)\n",
        "\n",
        "# removal of URL token\n",
        "tweets_df['Clean Text'] = tweets_df['Clean Text'].str.replace('URL', '')\n",
        "\n",
        "# replace empty cells with NaN values and drop them afterwards\n",
        "tweets_df['Clean Text'] = tweets_df['Clean Text'].replace(r'^\\s*$', np.nan, regex=True)\n",
        "tweets_df.dropna(subset=['Clean Text'], inplace=True)\n",
        "tweets_df['Clean Text'].isnull().values.any()"
      ],
      "id": "gzxyDueK2-no"
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "z1euX3oh3DX-"
      },
      "outputs": [],
      "source": [
        "# removing unwanted special characters in tweets\n",
        "spec_chars = [\"#\",\n",
        "              \"*\",\"+\",\"/\",\"<\",\n",
        "              \"=\",\">\",\"@\",\"[\",\"\\\\\",\"]\",\"^\",\"_\",\n",
        "              \"`\",\"{\",\"|\",\"}\",\"~\",\"€\",\"§\",\n",
        "              \"$\",\"°\"]\n",
        "for char in spec_chars:\n",
        "    tweets_df[\"Clean Text\"] = tweets_df[\"Clean Text\"].str.replace(char, ' ', regex=True)"
      ],
      "id": "z1euX3oh3DX-"
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "qfle2GE_jo04"
      },
      "outputs": [],
      "source": [
        "# creating new column of how many words are in each tweet\n",
        "tweets_df['Tweet Word Count'] = tweets_df[\"Clean Text\"].apply(lambda n: len(n.split()))\n",
        "\n",
        "# tweets that have less than 7 words will be removed\n",
        "# as suggested by (Folgado, Sanz, 2022, p. 990)\n",
        "tweets_df = tweets_df[tweets_df['Tweet Word Count'] > 6]\n",
        "tweets_df.reset_index(drop=True, inplace=True)"
      ],
      "id": "qfle2GE_jo04"
