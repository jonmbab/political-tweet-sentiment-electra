      "source": [
        "# hashtransformer will remove the # and seperate the words of the hashtags (if necessary)\n",
        "# the content of the hashtags will be converted to regular text which results in no information loss\n",
        "# and will facilitate input for the classification model\n",
        "\n",
        "ws = WordSegmenter(\n",
        "    segmenter_model_name_or_path=\"ml6team/gpt2-medium-german-finetune-oscar\",\n",
        "    reranker_model_name_or_path=\"bert-base-german-dbmdz-uncased\",\n",
        "    segmenter_gpu_batch_size=6,    # default value 1\n",
        "    reranker_gpu_batch_size=2000   # default value 2000\n",
        ")\n",
        "\n",
        "segmentations = ws.segment(\n",
        "    hashtag_match,\n",
        "    topk=20,                        # default value 20 --> lower value faster less accurate\n",
        "    steps=13,                       # default value 13 --> lower value faster less accurate\n",
        "    use_reranker=True               # default value True --> false faster\n",
        ")"
      ],
